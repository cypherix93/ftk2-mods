<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FTK2Mods.Crucible.Tests</RootNamespace>
    <AssemblyName>Crucible.Core.Tests</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Console test runner (no NuGet test framework: the repo build rules bar package
         references). Exit code 0 = every test passed, per the DevKit.Core.Tests pattern. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crucible.Core\Crucible.Core.csproj" />
  </ItemGroup>

</Project>
