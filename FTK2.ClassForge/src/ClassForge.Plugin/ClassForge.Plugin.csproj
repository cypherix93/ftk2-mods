<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>FTK2.ClassForge</AssemblyName>
    <RootNamespace>ClassForge.Plugin</RootNamespace>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Game install; override with -p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">E:\Games\Steam\steamapps\common\For The King II</GameDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)\For The King II_Data\Managed</ManagedDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)\BepInEx\core</BepInExDir>
    <!-- Repo-root-relative -p: overrides (e.g. -p:ManagedDir=tools/bin/refs) resolve against the
         repo root, not this project dir; absolute overrides and the live-game defaults pass
         through Path.Combine unchanged. Same mechanism as DevKit.Plugin.csproj. -->
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\..\</RepoRoot>
    <ManagedDirResolved>$([System.IO.Path]::Combine('$(RepoRoot)', '$(ManagedDir)'))</ManagedDirResolved>
    <BepInExDirResolved>$([System.IO.Path]::Combine('$(RepoRoot)', '$(BepInExDir)'))</BepInExDirResolved>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- net472 has no built-in ReadOnlySpan<T>. System.Text.Json's Deserialize overload set names it,
         so the compiler needs the type present for overload resolution at every JsonSerializer call
         (ConfigMergePatches). NOTE: the game's Managed\System.Memory.dll is a 4.6 KB *type-forwarding
         facade* (its Span/ReadOnlySpan live in Unity's own mscorlib), so HintPath-ing it yields
         CS0518 "predefined type not defined" — the real reference assembly must come from NuGet.
         Compile-time only: PrivateAssets="all" + ExcludeAssets="runtime" copies nothing into the
         plugin output; the game's facade + Unity mscorlib serve at runtime, exactly like every
         other <Reference> here (all Private=false).
         System.Runtime.CompilerServices.Unsafe is pinned to 6.0.0 purely to unify against the
         version the game's System.Text.Json binds to, which keeps the build at 0 warnings. -->
    <PackageReference Include="System.Memory" Version="4.5.5" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassForge.Core\ClassForge.Core.csproj" />
    <ProjectReference Include="..\ClassForge.Recipes\ClassForge.Recipes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDirResolved)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDirResolved)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FTK2">
      <HintPath>$(ManagedDirResolved)\FTK2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDirResolved)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDirResolved)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(ManagedDirResolved)\UnityEngine.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDirResolved)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDirResolved)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Text.Json">
      <HintPath>$(ManagedDirResolved)\System.Text.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SerializedSortedDictionary">
      <HintPath>$(ManagedDirResolved)\SerializedSortedDictionary.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
