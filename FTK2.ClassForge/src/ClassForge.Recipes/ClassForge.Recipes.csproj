<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>ClassForge.Recipes</RootNamespace>
    <AssemblyName>ClassForge.Recipes</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- ClassForge skill-recipe engine (SPEC-DELTA-v1.1). Deliberately game-agnostic:
         NO BepInEx, NO Unity, NO FTK2 game refs, NO NuGet PackageReference.
         The Plugin unit adapts real game objects onto the abstractions in Abstractions/.
         All arithmetic is int/decimal for cross-peer determinism (docs/MULTIPLAYER.md R2). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Cross-peer identity only (ClassForge.Core.Rng.EntityKey / StableHash). ClassForge.Core is
         netstandard2.0 and game-agnostic, so this keeps the "no game refs" rule above intact. It is
         referenced because Entity.Guid is LOCAL to a peer and must never be ordered, hashed or seeded
         on; EntityKey is the ordinal-based replacement, and there must be exactly ONE definition of
         its text form across the whole mod. -->
    <ProjectReference Include="..\ClassForge.Core\ClassForge.Core.csproj" />
  </ItemGroup>

</Project>
